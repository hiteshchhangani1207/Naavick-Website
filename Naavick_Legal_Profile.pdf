            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Our Team</photoshop:LayerName>
                  <photoshop:LayerText>Our Team</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Muskan Agrawal</photoshop:LayerName>
                  <photoshop:LayerText>Muskan Agrawal</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Nishtha Khandelwal</photoshop:LayerName>
                  <photoshop:LayerText>Nishtha Khandelwal</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Company Secretary </photoshop:LayerName>
                  <photoshop:LayerText>Company Secretary </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>She is passionately moving ahead towards becoming a specialist </photoshop:LayerName>
                  <photoshop:LayerText>She is passionately moving ahead towards becoming a specialist in Corporate and Commercial Laws and is engaged in a variety of transactions in the nature of mergers (including distressed M&amp;A under the Insolvency and Bankruptcy Code), acquisitions, corporate insolvency and restructuring. She also regularly advises resolution applicants on their bids under the Insolvency and Bankruptcy Code, apart from advising committee of creditors and resolution professionals. She has also advised on corporate governance, general corporate and disclosure matters.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>She has been involved in transactions involving legal issues on</photoshop:LayerName>
                  <photoshop:LayerText>She has been involved in transactions involving legal issues on various aspects such as RPT, CSR, schemes of arrangement, etc and has also advised on aspects relating to Securities Law. She is guiding clients on strengthening their internal compliance and governance frameworks, so as to ensure compliance with the changing requirements of the Companies Act and LODR.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Lorem Ipsum</photoshop:LayerName>
                  <photoshop:LayerText>Lorem Ipsum</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Lorem Ipsum</photoshop:LayerName>
